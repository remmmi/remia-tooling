{
  "description": "markitdown : mise en place de l'environnement Python et de to-md, règle d'aiguillage en début de session",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          { "type": "command", "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/setup.sh\"", "timeout": 600 },
          { "type": "command", "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/rule.sh\"", "timeout": 5 }
        ]
      }
    ]
  }
}
