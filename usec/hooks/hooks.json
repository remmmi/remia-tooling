{
  "description": "usec : mise en place des scripts, règle quotas en début de session, surveillance silencieuse",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          { "type": "command", "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/setup.sh\"", "timeout": 60 },
          { "type": "command", "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/rule.sh\"", "timeout": 5 }
        ]
      }
    ],
    "UserPromptSubmit": [
      { "hooks": [ { "type": "command", "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/watch.sh\"", "timeout": 5 } ] }
    ],
    "PostToolUse": [
      { "hooks": [ { "type": "command", "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/watch.sh\"", "timeout": 5 } ] }
    ]
  }
}
