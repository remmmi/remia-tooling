{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "prismtext/result/1",
  "title": "PrismText result (produit par le LLM, une variante)",
  "type": "object",
  "required": [
    "prismtext",
    "prism",
    "variant",
    "segments",
    "concepts"
  ],
  "properties": {
    "prismtext": {
      "const": "1"
    },
    "prism": {
      "type": "object",
      "required": [
        "id",
        "version",
        "sha256"
      ],
      "description": "tampon recopie de `prismtext prism <fichier>`"
    },
    "variant": {
      "type": "string",
      "minLength": 1
    },
    "segments": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "text"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "text": {
            "type": "string"
          }
        }
      }
    },
    "concepts": {
      "type": "array",
      "description": "carte source -> cible ; cible = citation exacte du segment cible, ou null avec motif",
      "items": {
        "type": "object",
        "required": [
          "segment",
          "concept",
          "cible"
        ],
        "properties": {
          "segment": {
            "type": "string"
          },
          "concept": {
            "type": "string"
          },
          "cible": {
            "type": [
              "string",
              "null"
            ]
          },
          "motif": {
            "type": "string"
          }
        }
      }
    },
    "ajouts": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "segment": {
            "type": "string"
          },
          "texte": {
            "type": "string"
          },
          "nature": {
            "type": "string",
            "enum": [
              "enjolivement",
              "fait"
            ],
            "description": "enjolivement : alerte, acceptee en mode auto ; fait : erreur ajout-fait"
          }
        }
      }
    },
    "inverse": {
      "type": "array",
      "description": "passe inverse cible -> source, idealement produite par un verificateur independant (commande inverse) ; peut aussi etre fournie a check par --inverse",
      "items": {
        "type": "object",
        "required": [
          "segment",
          "cible",
          "source"
        ],
        "properties": {
          "segment": {
            "type": "string"
          },
          "cible": {
            "type": "string"
          },
          "source": {
            "type": [
              "string",
              "null"
            ],
            "description": "citation exacte de la source, extrait d'une reference, ref:<id>, ref:<id>.<cle>, ou null"
          },
          "probleme": {
            "type": "string",
            "pattern": "^[a-z0-9-]+$",
            "description": "code d'une regle du prisme (section VERIFICATEUR) que le verificateur declare violee : erreur portant ce code"
          }
        }
      }
    }
  }
}\n