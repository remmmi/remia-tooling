{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "prismtext/input/1",
  "title": "PrismText input (produit par l'adaptateur, commande extract)",
  "type": "object",
  "required": [
    "prismtext",
    "source",
    "segments"
  ],
  "properties": {
    "prismtext": {
      "const": "1"
    },
    "source": {
      "type": "object",
      "required": [
        "adapter",
        "ref"
      ],
      "properties": {
        "adapter": {
          "type": "string",
          "description": "nom de l'adaptateur dans .prismtext/config.json"
        },
        "ref": {
          "type": "string",
          "description": "reference de la source, comprise par l'adaptateur (chemin, ID, URL)"
        }
      }
    },
    "context": {
      "type": "object",
      "description": "entrees du prisme : public, support, objectif, voix, longueur, conserver (a garder mot pour mot), lengthTolerance (defaut 0.35), rendu (texte visible de l'item entier tel que le lecteur le voit, gabarit compris : lecture seule, garantit la coherence de la reecriture)",
      "properties": {
        "conserver": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "lengthTolerance": {
          "type": "number",
          "minimum": 0
        },
        "rendu": {
          "type": "string"
        },
        "forbid": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "description": "termes interdits dans tous les segments (insensible a la casse) : erreur terme-interdit"
        },
        "forbidPatterns": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "regex interdites (flags giu) : erreur motif-interdit"
        },
        "maxOccurrences": {
          "type": "object",
          "additionalProperties": {
            "type": "integer",
            "minimum": 0
          },
          "description": "mot entier -> nombre maximal d'occurrences par segment : erreur occurrences-max"
        }
      }
    },
    "protect": {
      "type": "array",
      "description": "tokens proteges ; un groupe nomme (?<keep>...) limite la protection a cette partie",
      "items": {
        "type": "object",
        "required": [
          "name",
          "regex"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "regex": {
            "type": "string"
          },
          "note": {
            "type": "string"
          }
        }
      }
    },
    "segments": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "text"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "text": {
            "type": "string"
          },
          "role": {
            "type": "string",
            "description": "indication libre : title, body, meta, cta..."
          },
          "constraints": {
            "type": "object",
            "properties": {
              "freeze": {
                "type": "boolean"
              },
              "maxChars": {
                "type": "integer",
                "minimum": 1
              },
              "lengthTolerance": {
                "type": "number",
                "minimum": 0
              },
              "minChars": {
                "type": "integer",
                "minimum": 1
              },
              "forbid": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "forbidPatterns": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "maxOccurrences": {
                "type": "object",
                "additionalProperties": {
                  "type": "integer",
                  "minimum": 0
                }
              }
            }
          }
        }
      }
    },
    "lineage": {
      "type": "array",
      "description": "prismes deja appliques (commande chain)"
    },
    "references": {
      "type": "array",
      "description": "matiere annexe a la source (nom, specs, lecture de photo...), par rang de confiance ; le redacteur la recoit, le verificateur la cite (extrait litteral, ref:<id>, ref:<id>.<cle>). Ses chiffres et noms propres comptent comme source sauf numeric:false. citable:false ou les cles uncitable ne sourcent rien.",
      "items": {
        "type": "object",
        "required": [
          "id",
          "trust"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9_-]+$"
          },
          "trust": {
            "type": "integer",
            "minimum": 1,
            "description": "1 = le plus sur ; un rang plus petit l'emporte en cas de desaccord"
          },
          "text": {
            "type": "string"
          },
          "facts": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            }
          },
          "uncitable": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "cles de facts qu'aucune citation ne peut invoquer"
          },
          "numeric": {
            "type": "boolean",
            "description": "false : ses chiffres ne sourcent aucun chiffre de la cible (lecture de photo)"
          },
          "citable": {
            "type": "boolean",
            "description": "false : connue des agents, mais aucune citation ne peut l'invoquer (prix, emballage, impression)"
          },
          "exclusive": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "valeurs mutuellement exclusives : une seule dans la cible, celle du nom s'il en porte une (hors-perimetre)"
          }
        }
      }
    }
  }
}\n