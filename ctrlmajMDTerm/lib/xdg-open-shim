#!/usr/bin/env bash
# Shim xdg-open : le terminal graphique (Ctrl+Maj+clic sur un chemin brut) appelle xdg-open <chemin>.
# Si c'est un .md absent en local dont le prefixe est declare dans le fichier remotes -> mdterm-open.
# Sinon : xdg-open systeme, inchange. Tout .md non relaye laisse sa raison dans le log.
REAL=/usr/bin/xdg-open; [ -x "$REAL" ] || REAL=/bin/xdg-open
cfg="${HERDR_MDTERM_CONF:-$HOME/.config/herdr-mdterm/remotes}"
log="$HOME/.cache/xdg-open-shim.log"; mkdir -p "$(dirname "$log")"
echo "$(date -u +%FT%TZ) args=[$*] parent=$(ps -o comm= -p $PPID 2>/dev/null)" >> "$log"

if [ $# -eq 1 ]; then
  if [[ "${1}" == mdterm://* ]]; then
    exec "$HOME/.local/bin/mdterm-open" "$1"
  fi
  a="${1#file://}"
  # Le terminal transmet le chemin complete d'espaces jusqu'au bord de la ligne (vu avec Ghostty
  # sur la sortie de Claude Code) : sans ce trim, "x.md      " n'est pas un .md et rien ne part.
  a="${a%"${a##*[![:space:]]}"}"
  a="$(printf '%s' "$a" | sed -E 's/:[0-9]+(:[0-9]+)?$//')"
  a="$(printf '%b' "${a//%/\\x}")"
  if [[ "${a,,}" == *.md ]]; then
    why=""
    if [[ "$a" != /* ]]; then why="chemin non absolu"
    elif [ -e "$a" ]; then
      echo "  -- non relaye : le fichier existe sur ce poste, ouverture locale" >> "$log"
      exec "$REAL" "$a"
    elif [ ! -r "$cfg" ]; then why="$cfg absent ou illisible"
    else
      while read -r prefix _; do
        [ -z "${prefix:-}" ] || [[ "$prefix" == \#* ]] && continue
        if [[ "$a" == "$prefix"* ]]; then
          echo "  -> mdterm-open $a" >> "$log"
          exec "$HOME/.local/bin/mdterm-open" "$a"
        fi
      done < "$cfg"
      why="aucun prefixe de $cfg ne couvre ce chemin"
    fi
    echo "  -- non relaye : $why" >> "$log"
  fi
fi
exec "$REAL" "$@"
