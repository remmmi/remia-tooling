{
  "description": "remia : propositions au démarrage de session, point dépôt vs local quand on parle de remia-tooling",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup",
        "hooks": [
          { "type": "command", "command": "\"${CLAUDE_PLUGIN_ROOT}/bin/remia-tooling\" hook", "timeout": 5 }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          { "type": "command", "command": "\"${CLAUDE_PLUGIN_ROOT}/bin/remia-tooling\" hook", "timeout": 5 }
        ]
      }
    ]
  }
}
