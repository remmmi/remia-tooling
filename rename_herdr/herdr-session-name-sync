#!/usr/bin/env python3
"""Aligne le libellé d'onglet herdr sur le nom de session Claude Code (/rename).

Claude Code n'a pas d'événement de hook sur `/rename` : il écrit le nom dans
~/.claude/sessions/<pid>.json (champs `name`, `nameSource`, `sessionId`). Ce script,
lancé par l'unité systemd utilisateur `rename-herdr.path` à chaque écriture dans ce
dossier, retrouve l'onglet herdr qui héberge la session et le renomme.

Règles : seuls les noms `nameSource: user` comptent ; chaque /rename n'est appliqué
qu'une fois par onglet (état ~/.cache/rename-herdr/<sessionId> = onglet, pane et
horodatage `nameSince` du /rename), donc un libellé changé à la main ensuite reste,
mais un /rename refait (même nom) ou une session reprise dans un autre onglet
s'appliquent ; sans herdr joignable, sortie silencieuse (code 0).

Options : --dry-run (montre sans renommer), --verbose, --reset (oublie l'état).
Réglage : RENAME_HERDR_TARGET=tab|pane|both (défaut tab), HERDR_BIN=<chemin>.
"""
import glob
import json
import os
import shutil
import subprocess
import sys

HOME = os.path.expanduser("~")
SESSIONS = os.path.join(HOME, ".claude", "sessions")
STATE = os.path.join(HOME, ".cache", "rename-herdr")
TARGET = os.environ.get("RENAME_HERDR_TARGET", "tab")


def find_herdr():
    for cand in (os.environ.get("HERDR_BIN"), shutil.which("herdr"),
                 os.path.join(HOME, ".local", "bin", "herdr"),
                 os.path.join(HOME, ".cargo", "bin", "herdr")):
        if cand and os.access(cand, os.X_OK):
            return cand
    return None


def alive(pid):
    """Le pid est-il vivant ? Sous Windows os.kill(pid, 0) TERMINE le processus :
    porter avec psutil.pid_exists ou OpenProcess avant d'utiliser ce script là-bas."""
    if os.name != "posix":
        raise SystemExit("herdr-session-name-sync : test de pid non porté hors POSIX (voir TECHNIQUE.md)")
    try:
        os.kill(int(pid), 0)
        return True
    except (OSError, TypeError, ValueError):
        return False


def main(argv):
    dry = "--dry-run" in argv
    verbose = "--verbose" in argv or dry
    if "--reset" in argv:
        shutil.rmtree(STATE, ignore_errors=True)
    herdr = find_herdr()
    if not herdr:
        if verbose:
            print("herdr introuvable (PATH, ~/.local/bin, ~/.cargo/bin, HERDR_BIN)", file=sys.stderr)
        return 0

    def run(*args):
        return subprocess.run([herdr, *args], capture_output=True, text=True, timeout=10)

    try:
        listing = run("agent", "list")
        agents = json.loads(listing.stdout)["result"]["agents"]
    except Exception as exc:  # herdr pas lancé, socket absent, JSON inattendu
        if verbose:
            print(f"herdr injoignable : {exc}", file=sys.stderr)
        return 0
    by_session = {
        a["agent_session"]["value"]: a
        for a in agents
        if isinstance(a.get("agent_session"), dict) and a["agent_session"].get("value")
    }
    os.makedirs(STATE, exist_ok=True)
    for path in glob.glob(os.path.join(SESSIONS, "*.json")):
        try:
            with open(path, encoding="utf-8") as fh:
                meta = json.load(fh)
        except Exception:
            continue
        if meta.get("nameSource") != "user":
            continue
        name, sid = meta.get("name"), meta.get("sessionId")
        if not name or not sid or not alive(meta.get("pid")):
            continue
        agent = by_session.get(sid)
        if not agent:
            if verbose:
                print(f"{sid[:8]} '{name}' : pas de pane herdr pour cette session")
            continue
        state_file = os.path.join(STATE, sid)
        # Clé = où et quel /rename : un --resume dans un autre onglet, ou un /rename refait
        # avec le même nom (nouveau nameSince), doivent réappliquer.
        stamp = f"{agent['tab_id']} {agent['pane_id']} {meta.get('nameSince', '')}\n{name}"
        try:
            with open(state_file, encoding="utf-8") as fh:
                last = fh.read()
        except Exception:
            last = None
        if last == stamp:
            if verbose:
                print(f"{agent['tab_id']} '{name}' : déjà appliqué")
            continue
        if dry:
            print(f"{agent['tab_id']} -> '{name}' (dry-run)")
            continue
        ok = True
        if TARGET in ("tab", "both"):
            ok &= run("tab", "rename", agent["tab_id"], name).returncode == 0
        if TARGET in ("pane", "both"):
            ok &= run("pane", "rename", agent["pane_id"], name).returncode == 0
        if ok:
            with open(state_file, "w", encoding="utf-8") as fh:
                fh.write(stamp)
            print(f"{agent['tab_id']} -> {name}")
        else:
            print(f"{agent['tab_id']} : échec du renommage en '{name}'", file=sys.stderr)
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
